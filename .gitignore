# ==============================================================================
# ProbTalk3D .gitignore — Clean Directory Segregation
# ==============================================================================

# 1. Environments & Editor Artifacts
.idea/
.vscode/
.ipynb_checkpoints/
.venv/
venv/
env/
**/__pycache__/
__pycache__/

# 2. Large Pretrained Weights & Checkpoints (Host externally)
model_weights/
weights.zip
*.ckpt
*.pt
*.pth

# 3. Media Libraries & Rendered Video Outputs
demo_videos/
interactive_videos/
*.mp4
*.avi
*.npy
/*.png

# 4. Experiment Results & Scratch Logs
colab_results/
logs.*
*.log

# 5. Runtime Inference I/O Directories
demo_input/
dynamic_input/
one_audio/
results/generation/vqvae_pred/
ours/logs/smoke_audio/
client_outputs/
ours/runs/

# 6. Ground-truth datasets (never commit)
*.zip
*.tar
*.hdf5
datasets/3DMEAD_preprocess/EMICA-MEAD_flame2020/*/
datasets/3DMEAD_preprocess/MEAD_audio_source/*/
datasets/mead/wav/*.wav

# survey: keep private until the survey closes
ours/survey/answer_key.txt
ours/survey/*.mp4
results/evaluation/

# FLAME model files (licensed, kept in the private HF repo)
deps/flame/model/*.pkl
deps/flame/model/*.npy
_project_files/
.gradio/
